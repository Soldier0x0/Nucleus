{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@core/*": ["../frontend/src/core/*"],
      "expo-crypto": ["./src/coreShims/expo-crypto.ts"],
      "@/src/utils/storage": ["./src/coreShims/phoneStorage.ts"]
    }
  },
  "include": ["src"]
}
