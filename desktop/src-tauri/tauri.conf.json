{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nucleus",
  "version": "0.18.0",
  "identifier": "app.nucleus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nucleus",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://overpass-api.de https://nominatim.openstreetmap.org",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: hrsrc:; script-src 'self' https://localhost:* 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ws://localhost:1420 http://localhost:1420 ws://127.0.0.1:1420 http://127.0.0.1:1420 https://overpass-api.de https://nominatim.openstreetmap.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Nucleus, offline life organiser",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RDU0NkQ1NkNCREUwNUIKUldSYjRMMXMxVWJWQkxiQjFqUG5IQUdRYUp5cDladzFlYlNTaGFoT2xwdGJkbkZBM245Yjk3eWMK",
      "endpoints": [
        "https://github.com/Soldier0x0/Nucleus/releases/latest/download/latest.json"
      ]
    }
  }
}
