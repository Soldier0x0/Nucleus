{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app-data files, native dialogs, opener, the PIN key vault and the update feed.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "stronghold:default",
    "stronghold:allow-destroy",
    "fs:default",
    "fs:write-all",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default"
  ]
}
