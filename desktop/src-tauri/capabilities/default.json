{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app-data files, native dialogs, opener and the PIN key vault.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "stronghold:default",
    "stronghold:allow-destroy",
    "fs:default",
    "fs:write-all"
  ]
}
