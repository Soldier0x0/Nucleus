<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root_attention"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:id="@+id/attention_kicker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:letterSpacing="0.08"
    android:textAllCaps="true"
    android:textColor="@color/widget_accent"
    android:textSize="11sp" />

  <TextView
    android:id="@+id/attention_value"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:maxLines="2"
    android:ellipsize="end"
    android:textColor="@color/widget_ink"
    android:textSize="22sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/attention_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:maxLines="2"
    android:ellipsize="end"
    android:textColor="@color/widget_sub"
    android:textSize="13sp" />
</LinearLayout>
