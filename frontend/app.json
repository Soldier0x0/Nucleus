{
  "expo": {
    "name": "Nucleus",
    "slug": "nucleus",
    "version": "0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nucleus",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nucleus.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Nucleus quickly and privately"
      }
    },
    "android": {
      "package": "com.nucleus.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3EDE4"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_SMS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nucleus uses a photo you choose as a cover on your media shelf.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D68E42"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nucleus reads your location once for weather, then stops.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      "./plugins/withTextShare",
      "./plugins/withLauncherIcons"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}